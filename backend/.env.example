# Optional. Without it the API starts an in-memory MongoDB (data resets on restart).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/eccentric
# Set to "false" to refuse to start without a real database
ALLOW_MEMORY_DB=true
# Comma-separated list of sites allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173
PORT=5000
